<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="kr.go.kaptnet.user.mapper.UserMapper">

  <select id="findUserIdByUserSeqNo" resultType="java.lang.Integer">
    select user_id from user where user_seq_no = #{userSeqNo}
  </select>

</mapper>