<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.go.kaptnet.book.mapper.BookMapper">

    <!-- resultType 예시: 단순 1:1 매핑 -->
    <select id="findAll" resultType="kr.go.kaptnet.book.dto.BookDto">
        SELECT
            id,
            title,
            author,
            category,
            created_at AS createdAt,
            updated_at AS updatedAt
        FROM books
        ORDER BY id
    </select>

    <!-- resultType 예시: 단건 조회 -->
    <select id="findById" resultType="kr.go.kaptnet.book.dto.BookDto">
        SELECT
            id,
            title,
            author,
            category,
            created_at AS createdAt,
            updated_at AS updatedAt
        FROM books
        WHERE id = #{id}
    </select>

    <!-- 동적 SQL 예시: <where>, <if>, 파라미터 바인딩 #{ } -->
    <select id="search" resultType="kr.go.kaptnet.book.dto.BookDto">
        SELECT
            id,
            title,
            author,
            category,
            created_at AS createdAt,
            updated_at AS updatedAt
        FROM books
        <where>
            <if test="title != null and title != ''">
                AND title LIKE CONCAT('%', #{title}, '%')
            </if>
            <if test="author != null and author != ''">
                AND author LIKE CONCAT('%', #{author}, '%')
            </if>
            <if test="category != null and category != ''">
                AND category = #{category}
            </if>
        </where>
        ORDER BY id
    </select>

    <!-- CDATA 예시: XML 특수 문자 처리 (< > & " ') 및 비교 연산자 -->
    <select id="advancedSearch" resultType="kr.go.kaptnet.book.dto.BookDto">
        <![CDATA[
            SELECT
                id,
                title,
                author,
                category,
                created_at AS createdAt,
                updated_at AS updatedAt
            FROM books
            WHERE 1=1
        ]]>
        <if test="title != null and title != ''">
            <![CDATA[ AND title LIKE CONCAT('%', #{title}, '%') ]]>
        </if>
        <if test="author != null and author != ''">
            <![CDATA[ AND author LIKE CONCAT('%', #{author}, '%') ]]>
        </if>
        <if test="category != null and category != ''">
            <![CDATA[ AND category = #{category} ]]>
        </if>
        <if test="minId != null">
            <![CDATA[ AND id >= #{minId} ]]>
        </if>
        <if test="maxId != null">
            <![CDATA[ AND id <= #{maxId} ]]>
        </if>
        ORDER BY id
    </select>

</mapper>
